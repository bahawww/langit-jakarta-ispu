# Salin ke deploy/.env lalu isi. deploy/.env tidak di-commit.
POSTGRES_DB=ispu
POSTGRES_USER=ispu
# Buat dengan: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
LOG_LEVEL=INFO
# Port localhost untuk Caddy (cloudflared mengarah ke sini)
HTTP_PORT=8300
# Admin dashboard (wajib; api menolak start bila kosong). Gunakan password kuat untuk deploy publik.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Kunci tanda tangan JWT: openssl rand -base64 48
JWT_SECRET=
# true di produksi (HTTPS via Cloudflare). Browser tetap menerima cookie Secure di http://127.0.0.1.
COOKIE_SECURE=true
# Backup harian ke ./backups (jam WIB) dan jumlah file yang disimpan
BACKUP_HOUR=1
BACKUP_KEEP=14
# Sinkronisasi harian 03.00 WIB dari ekspor resmi Satu Data Jakarta (mati secara default)
SATUDATA_SYNC=false
